generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String    @id @default(cuid())
  cpf       String?   @unique
  name      String
  birthDate DateTime?
  email     String?
  whatsapp  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rentals Rental[]

  @@map("customers")
}

model Item {
  id          String     @id @default(cuid())
  name        String
  description String?
  type        String
  status      ItemStatus @default(available)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  photos      ItemPhoto[]
  prices      ItemPrice[]
  rentalItems RentalItem[]

  @@map("items")
}

model ItemPhoto {
  id        String   @id @default(cuid())
  itemId    String
  photoUrl  String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_photos")
}

model ItemPrice {
  id                 String   @id @default(cuid())
  itemId             String
  rentalPriceCents   Int
  depositAmountCents Int
  discountCents      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_prices")
}

model Rental {
  id              String       @id @default(cuid())
  customerId      String
  startDate       DateTime
  expectedEndDate DateTime
  status          RentalStatus @default(open)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer       Customer              @relation(fields: [customerId], references: [id])
  rentalItems    RentalItem[]
  payments       Payment[]
  financialLines RentalFinancialLine[]

  @@index([customerId])
  @@index([startDate, expectedEndDate])
  @@map("rentals")
}

model RentalItem {
  id                 String   @id @default(cuid())
  rentalId           String
  itemId             String
  rentalPriceCents   Int
  depositAmountCents Int
  discountCents      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rental      Rental       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  item        Item         @relation(fields: [itemId], references: [id])
  inspections Inspection[]

  @@unique([rentalId, itemId])
  @@index([itemId])
  @@map("rental_items")
}

model Payment {
  id          String        @id @default(cuid())
  rentalId    String
  type        PaymentType
  method      PaymentMethod
  amountCents Int
  status      PaymentStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@map("payments")
}

model RentalFinancialLine {
  id              String                    @id @default(cuid())
  rentalId        String
  type            RentalFinancialLineType
  amountCents     Int
  dueAt           DateTime
  lifecycleStatus RentalFinancialLineStatus @default(active)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([dueAt])
  @@map("rental_financial_lines")
}

model Inspection {
  id           String         @id @default(cuid())
  rentalItemId String
  type         InspectionType
  photoUrl     String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  @@index([rentalItemId])
  @@map("inspections")
}

enum ItemStatus {
  available
  reserved
  rented
  cleaning
  maintenance
  inactive
}

enum RentalStatus {
  open
  closed
  cancelled
}

enum PaymentType {
  rental
  deposit
  refund
  late_fee
  damage_fee
}

enum PaymentMethod {
  pix
  credit_card
  debit_card
  cash
  bank_transfer
}

enum PaymentStatus {
  pending
  paid
  refunded
  cancelled
  failed
}

enum RentalFinancialLineType {
  rental_fee
  item_discount
  deposit
  general_discount
  late_fee
  damage_fee
  cleaning_fee
  maintenance_fee
}

enum RentalFinancialLineStatus {
  active
  cancelled
}

enum InspectionType {
  pickup
  return
}
